{
  // Disable auto "Organize Imports" on save to stop removal of unused imports
  "editor.codeActionsOnSave": {
    // Do not auto-organize imports (prevents auto-removal of unused imports like `import React`)
    "source.organizeImports": "never",
    // Only run fix-alls when explicitly requested (not on every save)
    "source.fixAll": "explicit",
    "source.fixAll.eslint": "explicit"
  },
  // Keep ESLint from auto-fixing (removing) things on save; still shows problems
  "eslint.codeActionsOnSave.mode": "problems",
  // Optional: if an extension is auto-sorting imports, disable at workspace level
  "typescript.preferences.autoImportFileExcludePatterns": [],
  "javascript.preferences.autoImportFileExcludePatterns": [],
  // Existing workspace settings preserved below
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.suggest.autoImports": true,
  "eslint.workingDirectories": [
    "Front-End"
  ],
  "python.defaultInterpreterPath": "./Back-End/venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "./Back-End"
  ],
  "python.terminal.activateEnvironment": true,
  "files.associations": {
    "*.tsx": "typescriptreact",
    "*.ts": "typescript"
  },
  "emmet.includeLanguages": {
    "typescriptreact": "html"
  },
  "editor.formatOnSave": true,
  "files.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "Front-End/.next": true,
    "Front-End/out": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "Front-End/.next": true,
    "Front-End/out": true,
    "**/__pycache__": true
  },
  "terminal.integrated.cwd": "${workspaceFolder}",
  "extensions.recommendations": [
    "ms-python.python",
    "ms-python.debugpy",
    "bradlc.vscode-tailwindcss",
    "esbenp.prettier-vscode",
    "ms-vscode.vscode-typescript-next",
    "dbaeumer.vscode-eslint"
  ]
}