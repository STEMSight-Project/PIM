"""
Unit tests for video.py API routes
Tests HLS streaming endpoints for playlist, segments, and status.
"""
import pytest
from fastapi.testclient import TestClient
from pathlib import Path
from unittest.mock import MagicMock, patch

from main import app


client = TestClient(app)


class TestVideoRoutes:
    """Test video streaming routes"""

    def test_get_hls_playlist_not_found(self):
        """Test playlist endpoint returns 404 for non-existent room"""
        response = client.get("/videos/hls/non-existent-room/playlist.m3u8")
        
        assert response.status_code == 404

    def test_get_hls_playlist_success(self, temp_recording_dir, sample_session_data):
        """Test successful playlist retrieval"""
        with patch('api_router.video.RECORDINGS_BASE_PATH', temp_recording_dir.parent):
            # Create mock recording directory and playlist
            room_path = temp_recording_dir.parent / "recordings" / f"room-{sample_session_data['room_id']}"
            room_path.mkdir(parents=True, exist_ok=True)
            playlist_path = room_path / "playlist.m3u8"
            playlist_path.write_text("#EXTM3U\n#EXT-X-VERSION:3\n")
            
            response = client.get(f"/videos/hls/{sample_session_data['room_id']}/playlist.m3u8")
            
            assert response.status_code == 200
            assert "application/vnd.apple.mpegurl" in response.headers.get("content-type", "")

    def test_get_recording_status_not_found(self):
        """Test status endpoint returns 404 for non-existent room"""
        response = client.get("/videos/hls/non-existent-room/status")
        
        assert response.status_code == 404

    def test_get_recording_status_success(self, sample_session_data):
        """Test successful status retrieval"""
        with patch('api_router.video.recording_manager') as mock_manager:
            mock_recorder = MagicMock()
            mock_recorder.session_id = sample_session_data["session_id"]
            mock_recorder.room_id = sample_session_data["room_id"]
            mock_recorder.is_recording = True
            mock_recorder.get_duration.return_value = 120
            mock_recorder.get_segment_count.return_value = 4
            mock_recorder.is_hls_ready.return_value = True
            mock_recorder.get_playlist_url.return_value = f"/videos/hls/{sample_session_data['room_id']}/playlist.m3u8"
            mock_recorder.recording_path = Path(f"recordings/room-{sample_session_data['room_id']}")
            
            mock_manager.get_recorder.return_value = mock_recorder
            
            response = client.get(f"/videos/hls/{sample_session_data['room_id']}/status")
            
            assert response.status_code == 200
            data = response.json()
            assert data["room_id"] == sample_session_data["room_id"]
            assert data["is_active"] is True
            assert data["duration"] == 120
            assert data["segment_count"] == 4

    def test_get_hls_segment_invalid_extension(self, sample_session_data):
        """Test segment endpoint rejects non-.ts files"""
        response = client.get(f"/videos/hls/{sample_session_data['room_id']}/invalid.mp4")
        
        assert response.status_code == 400

    def test_get_hls_segment_not_found(self, sample_session_data):
        """Test segment endpoint returns 404 for non-existent segment"""
        response = client.get(f"/videos/hls/{sample_session_data['room_id']}/segment-999.ts")
        
        assert response.status_code == 404

    def test_get_hls_segment_success(self, temp_recording_dir, sample_session_data):
        """Test successful segment retrieval"""
        with patch('api_router.video.RECORDINGS_BASE_PATH', temp_recording_dir.parent):
            # Create mock recording directory and segment
            room_path = temp_recording_dir.parent / "recordings" / f"room-{sample_session_data['room_id']}"
            room_path.mkdir(parents=True, exist_ok=True)
            segment_path = room_path / "segment-000.ts"
            segment_path.write_bytes(b"fake segment data")
            
            response = client.get(f"/videos/hls/{sample_session_data['room_id']}/segment-000.ts")
            
            assert response.status_code == 200
            assert "video/MP2T" in response.headers.get("content-type", "")


class TestVideoListRecordings:
    """Test listing recordings endpoint"""

    def test_list_recordings_empty(self):
        """Test listing recordings returns empty array"""
        with patch('api_router.video.RECORDINGS_BASE_PATH') as mock_path:
            mock_path.exists.return_value = False
            
            response = client.get("/videos/hls/list")
            
            assert response.status_code == 200
            assert response.json() == []

    def test_list_recordings_success(self, temp_recording_dir):
        """Test listing recordings returns correct data"""
        with patch('api_router.video.RECORDINGS_BASE_PATH', temp_recording_dir):
            # Create mock recordings
            room1 = temp_recording_dir / "room-AMB-001-ROOM-001"
            room1.mkdir()
            (room1 / "playlist.m3u8").touch()
            (room1 / "segment-000.ts").write_bytes(b"data" * 100)
            (room1 / "segment-001.ts").write_bytes(b"data" * 100)
            
            response = client.get("/videos/hls/list")
            
            assert response.status_code == 200
            data = response.json()
            assert len(data) > 0
